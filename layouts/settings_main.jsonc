                  {
                    "type": "item",
                    "max_width": 260,
                    "item": "moon_remains_required"
                  }
                ]
              },
              {
                "type": "group",
                "header": "",
                "content": [
                  {
                    "type": "item",
                    "max_width": 260,
                    "item": "majora_remains_required"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}