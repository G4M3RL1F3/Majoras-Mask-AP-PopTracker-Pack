//Use item codes from items/settings.jsonc and use them to decide how and in which order they're displayed.
{
  "settings_other": {
    "type": "array",
    "orientation": "horizontal",
    "margin": 5,
    "content": [
      {
        "type": "array",
        "orientation": "vertical",
